{
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel/output",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sync-fx",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/refresh-prices",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/snapshot-portfolio",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/sync-asset-catalog",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/security-audit",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/sync-treasury",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/check-crypto-liquidity",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/sync-fundamentals",
      "schedule": "0 8 * * 1"
    }
  ]
}
